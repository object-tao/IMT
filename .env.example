# Copy to .env and load with Node --env-file, or inject via deployment environment.
PORT=3100
HOST=127.0.0.1
DATABASE_FILE=./data/imt.sqlite
# Optional read-only global place reference database.
# GEO_DATABASE_FILE=./assets/geography/world.sqlite
# Production: PostgreSQL recommended. If set, DATABASE_FILE is ignored.
# DATABASE_URL=postgresql://imt:change-me@localhost:5432/imt
# AUTH_PASSWORD must be at least 16 characters before any non-loopback deployment.
# AUTH_PASSWORD=
# SESSION_SECRET=at-least-32-random-characters
# COOKIE_SECURE=true
# Road routing: server-only credentials. Ordinary map keys may not have truck permissions.
# AMAP_TRUCK_KEY=
# HERE_ROUTING_KEY=
# Cache disabled by default. Enable only if vendor terms allow temporary storage (0-3600 seconds).
ROAD_CACHE_TTL_SECONDS=0
